# Maintainer: local build, not published
pkgname=dualsense-haptics
pkgver=1.4.0
pkgrel=1
pkgdesc="Audio-to-haptics daemon and GUI for the DualSense controller over USB or Bluetooth"
# Ships a compiled helper (dualsense-hidlock, for the Bluetooth HID Proxy
# feature) so this can no longer be 'any' - the vast majority of desktop
# Linux is x86_64, and the Steam Deck's separate Decky plugin path doesn't
# need this helper at all (its backend already runs as root).
arch=('x86_64')
# dualsensectl is AUR-only (github.com/nowrep/dualsensectl); pacman -U only
# checks that it's already installed, it won't fetch it for you - install it
# via an AUR helper first (e.g. `paru -S dualsensectl`).
# libcap is needed both to build (gcc links nothing extra, but `setcap` at
# build time would be a mistake - see package() below) and, critically, at
# install time on the user's own machine, where post_install() actually runs
# setcap for real.
depends=('python' 'pyside6' 'python-evdev' 'libpulse' 'dualsensectl' 'libcap')
makedepends=('gcc' 'libcap')
license=('MIT')
install=dualsense-haptics.install
source=()
sha256sums=()

package() {
  local appdir="$pkgdir/usr/share/dualsense-haptics"
  install -dm755 "$appdir"
  install -m644 "$startdir"/../*.py "$appdir/"

  install -dm755 "$appdir/assets"
  if [ -d "$startdir/../assets" ]; then
    cp -a "$startdir"/../assets/. "$appdir/assets/"
  fi

  install -Dm755 "$startdir/dualsense-haptics.sh" "$pkgdir/usr/bin/dualsense-haptics"
  install -Dm644 "$startdir/dualsense-haptics.desktop" "$pkgdir/usr/share/applications/dualsense-haptics.desktop"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Compile only - do NOT setcap here. package() runs under fakeroot, which
  # does not fake Linux capabilities/xattrs, so a setcap here would silently
  # no-op and ship a helper with no capability at all. The real setcap runs
  # in post_install()/post_upgrade() (dualsense-haptics.install), against the
  # live filesystem with real root, after pacman has extracted the package.
  install -dm755 "$pkgdir/usr/lib/dualsense-haptics"
  gcc -O2 -Wall -o "$pkgdir/usr/lib/dualsense-haptics/dualsense-hidlock" "$startdir/src/dualsense-hidlock.c"

  install -Dm644 "$startdir/71-dualsense-haptics-uhid.rules" \
    "$pkgdir/usr/lib/udev/rules.d/71-dualsense-haptics-uhid.rules"
}

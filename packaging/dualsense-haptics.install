post_install() {
  getent group dualsense-haptics >/dev/null || groupadd -r dualsense-haptics
  # cap_dac_override (new alongside the existing cap_fowner) lets the helper
  # open the real DualSense's hidraw node on the app's behalf even once
  # 72-dualsense-haptics-proxy-lock.rules has locked it to root:root, and
  # create/remove that rule's marker file under /run (also root:root) - see
  # bt_hid_proxy.py's open_real_device()/_set_real_device_lock_marker().
  setcap 'cap_fowner,cap_dac_override+ep' /usr/lib/dualsense-haptics/dualsense-hidlock || \
    echo ">>> Warning: setcap failed - the Bluetooth HID Proxy feature will be unavailable."
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=misc --sysname-match=uhid 2>/dev/null || true
  # Re-applies the LED sysfs permission rule to an already-connected
  # controller too, not just ones plugged in after this install/upgrade.
  udevadm trigger --subsystem-match=leds 2>/dev/null || true
  echo ">>> To use the Bluetooth HID Proxy (Trigger + Vibration Mix) feature, add yourself"
  echo ">>> to the new group and log out and back in:"
  echo ">>>     sudo usermod -aG dualsense-haptics \$USER"
}

post_upgrade() {
  post_install
}

post_remove() {
  getent group dualsense-haptics >/dev/null && groupdel dualsense-haptics 2>/dev/null || true
  # Tmpfs (/run), so this would disappear on its own at the next reboot
  # regardless - removed now too so a real DualSense isn't left locked to
  # root:root (72-dualsense-haptics-proxy-lock.rules is itself gone along
  # with this package, but only takes effect on the device's *next*
  # reconnect - the marker alone doesn't touch anything already locked).
  rm -f /run/dualsense-haptics/lock-real-device 2>/dev/null || true
  # rmdir, not rm -rf: only ever removes it if it's actually empty (i.e.
  # nothing unexpected is using it), leaving a genuinely stale/foreign
  # directory alone rather than silently deleting it.
  rmdir /run/dualsense-haptics 2>/dev/null || true
}
